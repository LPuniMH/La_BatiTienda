* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  color: #253047;
  background: #f5f6f8;
  line-height: 1.6;
}

header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
  padding: 20px 32px;
  background: white;
  border-bottom: 1px solid #ddd;
}

nav {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
}

a {
  color: #245bb2;
}

main {
  max-width: 640px;
  margin: 48px auto;
  padding: 28px;
  background: white;
  border: 1px solid #ddd;
  border-radius: 8px;
}

h1 {
  margin-top: 0;
  font-size: 28px;
}

form {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

input,
button {
  padding: 12px;
  font: inherit;
  border-radius: 4px;
}

input {
  min-width: 0;
  border: 1px solid #8b95a5;
}

button {
  border: none;
  color: white;
  background: #245bb2;
  cursor: pointer;
}

button:hover {
  background: #19478e;
}

.error {
  margin: 0;
  color: #b42318;
}

@media (max-width: 680px) {
  main {
    margin: 24px 16px;
    padding: 20px;
  }
}
